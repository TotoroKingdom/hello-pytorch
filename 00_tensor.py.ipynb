   "source": [
    "import torch\n",
    "\n",
    "# 创建张量\n",
    "x = torch.tensor([1, 2, 3])\n",
    "\n",
    "print(x)\n",
    "\n",
    "# 查看形状\n",
    "print(x.shape)\n",
    "\n",
    "# 矩阵乘法\n",
    "a = torch.randn(2, 3)\n",
    "print(a)\n",
    "b = torch.randn(3, 4)\n",
    "print(b)\n",
    "c = a @ b\n",
    "\n",
    "print(c)\n",
    "print(c.shape)"
   ],
